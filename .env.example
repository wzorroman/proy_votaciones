# Variables de entorno para el contenedor
# Este archivo se monta en el contenedor via docker-compose (env_file).

DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga-y-segura
# Lista separada por comas. "*" permite cualquier host (util en pruebas LAN/Docker).
ALLOWED_HOSTS=*,localhost,127.0.0.1,0.0.0.0,172.21.0.2
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0:8000

# Base de datos SQLite dentro del contenedor (el archivo se persiste en el volumen "dbdata")
DATABASE_URL=sqlite:////app/data/db.sqlite3

HASH_SALT=cambia-esto-por-un-salt-seguro
VOTE_KEY=cambia-esto-por-una-clave-para-firma-de-voto

# Datos demo (seed_demo): "true" para cargarlos automaticamente al arrancar
LOAD_DEMO_DATA=false
# Si "true", borra el proceso demo y lo recrea desde cero
LOAD_DEMO_RESET=false
LOAD_DEMO_ADMIN_USER=admin
LOAD_DEMO_ADMIN_PASS=admin
LOAD_DEMO_ADMIN_EMAIL=admin@example.com